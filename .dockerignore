# Git
.git
.gitignore
.gitattributes
.github

# Environments and Secrets (Prevent leaking local tokens)
**/.env
**/.env.*
!**/.env.example

# Database and Data persistence
**/*.db
**/*.db-*
data/
server/data/
**/sync.db

# Logs
**/*.log
**/syncpk.log

# Python cache & virtual environments
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/venv/
**/.venv/

# Cache & Artwork
cache/
server/cache/

# Systemd units (unused in Docker)
server/systemd/

# Plans and docs
*.md

# Non-server directories (reduce build context size)
screenshots/
kodi_addon/
tools/
