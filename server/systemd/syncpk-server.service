[Unit]
Description=SyncPK Central Server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=syncpk
Group=syncpk
UMask=0077
WorkingDirectory=/opt/syncpk
Environment="DATA_DIR=/var/lib/syncpk"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/syncpk/venv/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000 --no-access-log
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
