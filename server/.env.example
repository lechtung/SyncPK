# ==========================================
# 1. External APIs & Server Configuration
# ==========================================
# Plex Server
PLEX_URL=http://your_plex_ip:32400
PLEX_TOKEN=your_plex_token_here
PLEX_CLIENT_ID=SPK-your_unique_client_id
HAS_PLEX_PASS=true

# TMDB (Posters & Artwork)
TMDB_API_KEY=your_tmdb_api_key_here

# ==========================================
# 2. Security (Auto-generated during install)
# ==========================================
SALT=random_string_for_token_encryption
WEB_SALT=random_string_for_password_hashing
WEB_HASH=web_password_scrypt_hash
API_HASH=api_token_hash
API_TOKEN_RAW=sk_random_token

# ==========================================
# 3. Languages & Scraping Behavior
# ==========================================
SYNC_LANGUAGE="es"
DASHBOARD_LANGUAGE="auto"

# Art Preferences (show/season/episode)
POSTER_PREF="show"
FANART_PREF="episode"

# Art Quality (dynamic/w92/w185/w300/w342/w500/original)
POSTER_QUALITY="dynamic"
FANART_QUALITY="dynamic"

# ==========================================
# 4. UI & Visuals
# ==========================================
# Controls the opacity of the dark mask over fanart images (0.0 to 1.0)
FANART_MASK_OPACITY=0.3
UI_POSTER_W=108
UI_POSTER_H=225
UI_FANART_W=288
UI_FANART_H=168
UI_GRID_GAP=15
UI_CARD_RADIUS=8
UI_BG_COLOR="#0d1117"
UI_GLASS_BG="rgba(22,27,34,0.7)"
UI_GLASS_BORDER="rgba(255,255,255,0.1)"
UI_EDIT_BG="rgba(22,27,34,0.85)"
UI_COMBO_BG="rgba(13,17,23,0.95)"
UI_PANEL_BG="rgba(255,255,255,0.03)"
UI_ACCENT_PRIMARY="#58a6ff"
UI_ACCENT_HOVER="#3182ce"
UI_ACCENT_DARK="#2568a8"
UI_DANGER="#f85149"
UI_TEXT_PRIMARY="#c9d1d9"
UI_TEXT_SECONDARY="#8b949e"
UI_GLASS_BLUR=10
UI_FONT="inter"
UI_SHOW_DURATION=true
UI_SHOW_TITLE=true

# ==========================================
# 5. Updates & Maintenance
# ==========================================
# Set to true to automatically download and apply updates from GitHub
AUTO_UPDATE=false

# If the user wants to be notified of new updates (true/false)
NOTIFY_UPDATES=true

# System state variables for updates (modified by the app)
UPDATE_AVAILABLE=
IGNORED_UPDATE_VERSION=

# ==========================================
# 6. Advanced Settings
# ==========================================
# Set to true to enable extensive backend debugging logs
DEBUG=false



